<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Kaizen</vendor>
  <vendor_url>https://github.com/kaizen</vendor_url>
  <action id="io.github.kaizen.sddm.deploy">
    <description>Deploy the Kaizen SDDM theme</description>
    <message>Authentication is required to deploy Kaizen's SDDM theme.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="io.github.kaizen.package.install">
    <description>Install packages through Kaizen</description>
    <message>Authentication is required to install packages through Kaizen.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="io.github.kaizen.package.remove">
    <description>Remove packages through Kaizen</description>
    <message>Authentication is required to remove packages through Kaizen.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
  <action id="io.github.kaizen.package.configure">
    <description>Configure a package through Kaizen</description>
    <message>Authentication is required to configure a package through Kaizen.</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
  </action>
</policyconfig>
